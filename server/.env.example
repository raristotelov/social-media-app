# Server environment variables
# Copy to .env and fill in real values

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/picstagram
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://127.0.0.1:27017/picstagram

# Port the server listens on
PORT=5000

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=your_jwt_secret_here

# Environment: development | production
NODE_ENV=development

# Origin of the client allowed to call the API with the session cookie (no trailing slash)
# Local:  http://localhost:3000
# Prod:   https://sharesnap.app
CLIENT_ORIGIN=http://localhost:3000

# Cloudinary credentials (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Upload folder: social-media-app/staging locally, social-media-app/production in prod
CLOUDINARY_FOLDER=social-media-app/staging

DEMO_ACTIVITY_TOKEN=your-demo-activyty-token
