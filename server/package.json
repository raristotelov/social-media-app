{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "migrate-mongo": "^14.0.7",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5"
  },
  "scripts": {
    "start": "node ./src/server.js",
    "dev": "node --watch ./src/server.js",
    "seed:assign": "node ./src/seed/assignPhotos.js",
    "seed:demo": "node ./src/seed/seedDemo.js",
    "seed:upload": "node ./src/seed/uploadPhotos.js",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status",
    "lint": "eslint src migrate-mongo-config.js",
    "lint:fix": "eslint src migrate-mongo-config.js --fix",
    "format": "prettier --write \"src/**/*.js\" migrate-mongo-config.js",
    "format:check": "prettier --check \"src/**/*.js\" migrate-mongo-config.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/migrations/"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/migrations/"
    ]
  },
