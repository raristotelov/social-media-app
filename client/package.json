{
    "name": "client",
    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1"
    },
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint --max-warnings 0 src cypress cypress.config.js vite.config.mjs eslint.config.js",
        "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"cypress/**/*.js\" cypress.config.js vite.config.mjs eslint.config.js",
        "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"cypress/**/*.js\" cypress.config.js vite.config.mjs eslint.config.js",
        "cypress:open": "cypress open",
        "cypress:run": "cypress run"
    },
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitest/coverage-v8": "^5.1.0",
        "cypress": "^16.2.1",
        "dotenv": "^18.0.9",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "prettier": "^3.9.10",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
